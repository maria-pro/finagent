# Which preset to start from: "local" (CPU, Ollama/llama.cpp) or "nim" (NVIDIA API catalog)
FINAGENT_PROFILE=local

# --- local profile -------------------------------------------------------
# Ollama:     ollama pull nemotron-3-nano:4b   (default endpoint below)
# llama.cpp:  llama-server -hf nvidia/NVIDIA-Nemotron-3-Nano-4B-GGUF:Q4_K_M --jinja -ngl 0 --port 8191
#             then set FINAGENT_BASE_URL=http://127.0.0.1:8191/v1
# FINAGENT_BASE_URL=http://127.0.0.1:11434/v1
# FINAGENT_ORCHESTRATOR_MODEL=nemotron-3-nano:4b
# FINAGENT_SPECIALIST_MODEL=nemotron-3-nano:4b

# --- nim profile ---------------------------------------------------------
# Free key from https://build.nvidia.com
# NVIDIA_API_KEY=nvapi-...

# --- optional overrides --------------------------------------------------
# FINAGENT_REASONING=false        # turn Nemotron's thinking mode on/off
# FINAGENT_MAX_CONCURRENCY=1      # parallel specialist agents
# FINAGENT_CACHE_DIR=.finagent_cache
# FINAGENT_TOPIC_RAIL_REQUIRED=1  # refuse questions when the topic-control rail does not answer
# FINAGENT_UI_SHARED=1            # web UI serving others: fixed endpoints, per-visitor runs (put it behind a login)

# SEC asks automated clients to identify themselves: "Name email@domain"
SEC_USER_AGENT="Your Name your.email@university.edu"
